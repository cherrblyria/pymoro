{
  "name": "pymoro",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "src/main.js",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "scripts": {
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.pymoro.app",
    "productName": "Pymoro",
    "win": {
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "icon": "assets/icons/512x512.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "description": "Pomodoro timer application",
  "keywords": [
    "pomodoro",
    "timer",
    "productivity"
  ],
  "author": "Cherrblyria",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cherrblyria/pymoro.git"
  },
  "bugs": {
    "url": "https://github.com/cherrblyria/pymoro/issues"
  },
  "homepage": "https://github.com/cherrblyria/pymoro#readme"
}
